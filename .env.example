# Environment variables for local development.
# Copy to .env and adjust. Never commit real secrets.

# PostgreSQL (infra/docker-compose.yml). Host port is 5433.
POSTGRES_USER=dpp
POSTGRES_PASSWORD=dpp

# Service database URLs (defaults shown; override if the host/port differs)
ORDER_DB_URL=jdbc:postgresql://localhost:5433/dpp_orders
PAYMENT_DB_URL=jdbc:postgresql://localhost:5433/dpp_payments
NOTIFICATION_DB_URL=jdbc:postgresql://localhost:5433/dpp_notifications

# Kafka and service discovery
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka

# Order lifecycle (order-service defaults; payment timeout stays below the
# catalog reservation TTL of 15 minutes)
ORDER_PAYMENT_TIMEOUT_MS=600000
ORDER_EXPIRY_SWEEP_INTERVAL_MS=60000

# API gateway Redis-backed rate limiting (PRD §16)
REDIS_HOST=localhost
REDIS_PORT=6379
GATEWAY_RATE_LIMIT_REPLENISH_RATE=20
GATEWAY_RATE_LIMIT_BURST_CAPACITY=40

# Auth (resource servers fetch the JWKS from the auth service)
AUTH_JWKS_URI=http://localhost:8081/.well-known/jwks.json
DPP_BOOTSTRAP_ADMIN_EMAIL=admin@dpp.local
DPP_BOOTSTRAP_ADMIN_PASSWORD=AdminPass123!

# Shared secret for /internal/** service-to-service calls
DPP_INTERNAL_SERVICE_TOKEN=dpp-internal-dev-token

# Payment provider ("simulated" or "stripe")
PAYMENT_PROVIDER=simulated
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=https://api.stripe.com
PAYMENT_RECONCILE_INTERVAL_MS=60000
PAYMENT_RECONCILE_STALE_MS=120000

# Notifications ("log" writes to the service log; "smtp" sends email via SMTP).
# SMTP_* are the Compose input names; infra/docker-compose.full.yml forwards them
# as SPRING_MAIL_* so Spring Boot's mail auto-configuration can bind them. When
# running notification-service outside Compose, set SPRING_MAIL_* directly.
DPP_NOTIFICATION_SENDER=log
DPP_NOTIFICATION_FROM=no-reply@dpp.local
SMTP_HOST=
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=25
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
# Spring Boot's mail health indicator probes the SMTP host. It is disabled by
# default because the log sender has no host; enable it when SMTP is configured.
MANAGEMENT_HEALTH_MAIL_ENABLED=false

# JWT signing. JWT_JWK_PATH points at a git-ignored RSA private JWK (private
# exponent included). If the file is missing, one is generated when
# JWT_GENERATE_IF_MISSING=true; keep the same file across restarts so existing
# tokens remain valid. Never commit the key file.
JWT_ISSUER=dpp-auth
JWT_JWK_PATH=./keys/auth-jwk.json
JWT_GENERATE_IF_MISSING=true
